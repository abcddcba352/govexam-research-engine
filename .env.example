# Persistence Backend: DATABASE | LOCAL_FILE | JSON_FIXTURE
PERSISTENCE_BACKEND=DATABASE

# Supabase Postgres & Storage Configuration (Server-Only, never prefix with VITE_)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here
# Optional legacy fallback:
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Google Gemini API Configuration
# Cloudflare deployment uses the AI binding and persistent free-engine queue.
AI_PROVIDER=cloudflare
FREE_ENGINE_DAILY_NEURONS=6000
GEMINI_API_KEY=your_gemini_api_key_here
# Separate YouTube Data API key for descriptions/material links. oEmbed needs no key.
YOUTUBE_API_KEY=
GEMINI_PRIMARY_MODEL=gemini-3.8-flash
MODEL_TIER_FALLBACK_POLICY=ALLOW_ECONOMY_FALLBACK_WITH_STRICT_AUDIT
NODE_ENV=development

# Local automatic research worker (npm run research:auto). No model/search API calls.
AUTO_RESEARCH_INTERVAL_HOURS=6
